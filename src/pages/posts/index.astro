---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PostList from '../../components/PostList.astro';
import PostSearch from '../../components/PostSearch.astro';
import SectionHead from '../../components/SectionHead.astro';
import SortToggle from '../../components/SortToggle.astro';
import { getVisiblePosts, toSearchEntries } from '../../lib/posts';

const posts = await getVisiblePosts();
const searchEntries = toSearchEntries(posts);

// 시안이 글 수를 두 자리로 채워 표시한다.
const countLabel = `총 ${String(posts.length).padStart(2, '0')}편 · 최신순`;
---

<BaseLayout title="모든 글 | 블로그" description="발행한 글을 모두 모아 최신순으로 정리했다.">
  <PageIntro
    eyebrow="Archive"
    heading="모든 글"
    description="읽고 만든 것을 기록한 글을 모두 모았다."
  />
  <section class="max-w-[760px]" data-od-id="all-posts-list">
    <PostSearch />
    <SectionHead title="전체 기록" note={posts.length > 0 ? countLabel : undefined}>
      <SortToggle slot="action" />
    </SectionHead>
    <p
      class="border-y border-border py-6 font-sans text-caption leading-meta text-muted"
      data-od-id="no-results"
      hidden
    >
      검색 결과가 없습니다.
    </p>
    <div class="mt-4" data-od-id="post-list-region">
      <PostList posts={posts} />
    </div>
    <script
      type="application/json"
      data-od-id="post-search-entries"
      set:html={JSON.stringify(searchEntries)}
    />
  </section>
</BaseLayout>

<script>
  interface SearchEntry {
    id: string;
    text: string;
    time: number;
  }

  const region = document.querySelector<HTMLElement>('[data-od-id="all-posts-list"]');
  const data = region?.querySelector<HTMLScriptElement>('[data-od-id="post-search-entries"]');
  const form = region?.querySelector<HTMLFormElement>('[data-od-id="post-search"]');
  const input = region?.querySelector<HTMLInputElement>('#post-search-input');

  if (region && data && form && input) {
    const entries: SearchEntry[] = JSON.parse(data.textContent ?? '[]');
    const items = new Map<string, HTMLElement>();
    region.querySelectorAll<HTMLElement>('[data-post-id]').forEach((item) => {
      items.set(item.dataset.postId ?? '', item);
    });

    const summary = region.querySelector<HTMLElement>('[data-od-id="section-note"]');
    const empty = region.querySelector<HTMLElement>('[data-od-id="no-results"]');
    const listRegion = region.querySelector<HTMLElement>('[data-od-id="post-list-region"]');

    const sortButton = region.querySelector<HTMLButtonElement>('[data-od-id="sort-toggle"]');
    const list = region.querySelector<HTMLElement>('[data-od-id="post-list"]');

    const state = { query: '', oldestFirst: false };

    /** 현재 상태로 남길 글을 고르고 정렬 기준대로 순서를 정한다. */
    function select(): SearchEntry[] {
      const matched =
        state.query === '' ? entries : entries.filter((entry) => entry.text.includes(state.query));
      const sorted = [...matched].sort((a, b) => b.time - a.time);
      return state.oldestFirst ? sorted.reverse() : sorted;
    }

    /** 고른 글만 목록에 남기고, 글 수와 결과 없음 안내를 함께 맞춘다. */
    function render() {
      const selected = select();
      const visible = new Set(selected.map((entry) => entry.id));
      items.forEach((item, id) => {
        item.hidden = !visible.has(id);
      });

      // 목록의 순서는 고른 결과의 순서를 그대로 따른다.
      selected.forEach((entry) => {
        const item = items.get(entry.id);
        if (item && list) list.append(item);
      });

      const sortLabel = state.oldestFirst ? '오래된 순' : '최신순';
      if (sortButton) {
        sortButton.setAttribute(
          'aria-label',
          state.oldestFirst ? '최신순으로 정렬' : '오래된 순으로 정렬',
        );
      }

      const found = selected.length > 0;
      if (listRegion) listRegion.hidden = !found;
      if (empty) empty.hidden = found;
      if (summary) {
        summary.textContent = `총 ${String(selected.length).padStart(2, '0')}편 · ${sortLabel}`;
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      state.query = input.value.trim().toLowerCase();
      render();
    });

    sortButton?.addEventListener('click', () => {
      state.oldestFirst = !state.oldestFirst;
      render();
    });

    // 조작이 실제로 동작하는 시점에만 조작 수단을 드러낸다.
    form.hidden = false;
    if (sortButton) sortButton.hidden = false;
    render();
  }
</script>
