---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostHeader from '../../components/PostHeader.astro';
import Prose from '../../components/Prose.astro';
import BackLink from '../../components/BackLink.astro';
import { getVisiblePosts, toSlugPath } from '../../lib/posts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({
    params: { slug: toSlugPath(post) },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="mx-auto max-w-[680px]" data-od-id="article-view">
    <div class="mb-12">
      <BackLink href="/posts" label="← 모든 글 보기" />
    </div>
    <PostHeader post={post} />
    <Prose><Content /></Prose>
  </article>
</BaseLayout>
