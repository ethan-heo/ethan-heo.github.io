---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostHeader from '../../components/PostHeader.astro';
import PostToc from '../../components/PostToc.astro';
import Prose from '../../components/Prose.astro';
import RelatedPost from '../../components/RelatedPost.astro';
import { getRelatedPost, getVisiblePosts, toSlugPath } from '../../lib/posts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({
    params: { slug: toSlugPath(post) },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedPost = await getRelatedPost(post);
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="mx-auto max-w-[680px]" data-od-id="article-view">
    <PostHeader post={post} />
    <PostToc headings={headings} />
    <Prose><Content /></Prose>
    <RelatedPost post={relatedPost} />
  </article>
</BaseLayout>
