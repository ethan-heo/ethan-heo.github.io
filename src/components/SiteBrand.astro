---
const siteName = '블로그';
const tagline = '읽고 만든 것을 기록한다.';
---

<a href="/" class="group inline-block no-underline" aria-label={siteName} data-od-id="site-brand">
  <span class="block font-sans text-h3 font-bold leading-tight text-fg group-hover:text-accent">
    {siteName}
  </span>
  <span class="block font-sans text-[0.72rem] leading-meta text-muted">{tagline}</span>
</a>
