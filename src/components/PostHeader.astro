---
import type { Post } from '../lib/posts';
import TagList from './TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<header class="mb-12" data-od-id="post-header">
  <h1 class="text-h1 leading-tight">{post.data.title}</h1>
  <p class="mt-4 font-sans text-muted leading-meta">{post.data.summary}</p>
  <p class="mt-4 font-mono text-caption text-muted leading-meta">
    <time datetime={post.data.date.toISOString()}>
      {dateFormat.format(post.data.date)}
    </time>
  </p>
  <div class="mt-4">
    <TagList tags={post.data.tags} label="이 글의 태그" />
  </div>
</header>
