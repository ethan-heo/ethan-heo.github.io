---
import type { Post } from '../lib/posts';
import { getReadingMinutes } from '../lib/posts';
import TagList from './TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 분류가 없는 글은 읽기 시간만 남기고 가운뎃점도 넣지 않는다.
const eyebrow = [post.data.category, `${getReadingMinutes(post)}분 읽기`]
  .filter(Boolean)
  .join(' · ');
---

<header class="mb-14" data-od-id="post-header">
  <p
    class="mb-[18px] font-mono text-[0.72rem] font-medium tracking-[0.1em] uppercase text-accent"
    data-od-id="post-eyebrow"
  >
    {eyebrow}
  </p>
  <h1 class="max-w-[18ch] text-[clamp(2.2rem,6vw,4.5rem)] leading-[1.35] font-bold">
    {post.data.title}
  </h1>
  <p class="mt-6 font-sans text-[1.08rem] leading-[1.85] text-muted">{post.data.summary}</p>
  <div
    class="flex flex-col items-start gap-2 pt-4 font-sans text-[0.78rem] leading-meta text-muted"
    data-od-id="post-meta"
  >
    <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
    <TagList tags={post.data.tags} label="이 글의 태그" />
  </div>
</header>
