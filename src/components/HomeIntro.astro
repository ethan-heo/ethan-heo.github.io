    {eyebrow}
  </p>
  <h1 class="max-w-[13ch] text-[clamp(2.2rem,6vw,4.8rem)] leading-[1.12] tracking-[-0.075em]">
    {heading}
  </h1>
  <p class="max-w-[580px] font-sans text-[1.08rem] leading-[1.8] text-muted">{description}</p>
</section>
