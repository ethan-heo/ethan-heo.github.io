---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';
import EmptyState from './EmptyState.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <EmptyState title="아직 발행한 글이 없습니다." />
  ) : (
    <ul class="flex flex-col gap-8" aria-label="최신 글부터" data-od-id="post-list">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </ul>
  )
}
