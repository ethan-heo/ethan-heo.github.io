---
// 보이는 화살표의 방향이 현재 정렬을 알린다. 최신순이면 아래, 오래된 순이면 위를 가리킨다.
---

<button
  class="inline-flex min-h-11 min-w-11 items-center justify-center bg-transparent text-fg hover:text-accent"
  type="button"
  hidden
  aria-label="오래된 순으로 정렬"
  data-od-id="sort-toggle"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="h-[18px] w-[18px] fill-none stroke-current"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    data-od-id="sort-icon-desc"
  >
    <path d="M12 4v16m0 0-5-5m5 5 5-5"></path>
  </svg>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="h-[18px] w-[18px] fill-none stroke-current"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    data-od-id="sort-icon-asc"
    hidden
  >
    <path d="M12 20V4m0 0-5 5m5-5 5 5"></path>
  </svg>
</button>
