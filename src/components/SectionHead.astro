---
interface Props {
  title: string;
  note?: string;
}

const { title, note } = Astro.props;
---

<div class="flex items-baseline justify-between gap-4">
  <h2 class="text-h3 leading-tight">{title}</h2>
  <div class="flex items-baseline gap-2">
    {
    note && (
      <span class="font-sans text-[0.78rem] leading-meta text-muted" data-od-id="section-note">
        {note}
        </span>
      )
    }
    <slot name="action" />
  </div>
</div>
