---
import Tag from './Tag.astro';

interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = '태그' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-x-1.5 gap-y-0.5" aria-label={label}>
      {tags.map((tag) => (
        <Tag name={tag} />
      ))}
    </ul>
  )
}
