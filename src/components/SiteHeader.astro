---
import SiteBrand from './SiteBrand.astro';
import ThemeToggle from './ThemeToggle.astro';

/** 아이콘 조작 셋이 같은 크기와 색을 쓰도록 클래스를 한자리에 둔다. */
const toolClass =
  'inline-flex min-h-11 min-w-9 items-center justify-center bg-transparent text-fg hover:text-accent';
const iconClass = 'h-5 w-5 fill-none stroke-current';
---

<header class="flex items-center justify-between gap-4 py-7" data-od-id="site-header">
  <SiteBrand />
  <nav class="flex items-center gap-2" aria-label="페이지 도구">
    <a href="/posts" class={toolClass} aria-label="모든 글 보기" data-od-id="articles-link">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class={iconClass}
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 6h16M4 12h16M4 18h10"></path>
      </svg>
    </a>
    <ThemeToggle />
  </nav>
</header>
