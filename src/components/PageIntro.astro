---
interface Props {
  eyebrow: string;
  heading: string;
  description: string;
}

const { eyebrow, heading, description } = Astro.props;
---

<section class="mb-[clamp(4rem,10vw,7rem)] max-w-[720px]" data-od-id="page-intro">
  <p class="font-mono text-[0.72rem] font-medium tracking-[0.12em] uppercase text-accent">
    {eyebrow}
  </p>
  <h1 class="text-[clamp(2.2rem,6vw,4.8rem)] leading-[1.12] tracking-[-0.075em] text-balance">
    {heading}
  </h1>
  <p class="max-w-[580px] font-sans text-[1.08rem] leading-[1.8] text-muted">{description}</p>
</section>
