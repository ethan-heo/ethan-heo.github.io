---
// 번호와 버튼의 상태는 화면의 스크립트가 갱신한다. 여기서는 골격만 둔다.
---

<nav
  class="mt-10 flex items-center justify-center gap-2"
  aria-label="글 목록 페이지"
  hidden
  data-od-id="pagination"
>
  <button
    class="inline-flex min-h-11 min-w-11 items-center justify-center bg-transparent font-sans text-caption text-fg hover:text-accent disabled:text-muted disabled:hover:text-muted"
    type="button"
    aria-label="이전 페이지 묶음"
    data-od-id="pagination-prev"
  >
    이전
  </button>
  <ol class="flex items-center gap-1" data-od-id="pagination-numbers"></ol>
  <button
    class="inline-flex min-h-11 min-w-11 items-center justify-center bg-transparent font-sans text-caption text-fg hover:text-accent disabled:text-muted disabled:hover:text-muted"
    type="button"
    aria-label="다음 페이지 묶음"
    data-od-id="pagination-next"
  >
    다음
  </button>
</nav>
