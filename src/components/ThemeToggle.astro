---
// 초기 테마는 BaseLayout의 인라인 스크립트가 정한다. 여기서는 전환만 맡는다.
---

<button
  type="button"
  class="theme-toggle inline-flex min-h-11 min-w-9 items-center justify-center bg-transparent text-fg hover:text-accent"
  aria-label="테마 전환"
  data-od-id="theme-toggle"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="h-5 w-5 fill-none stroke-current"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"></path>
  </svg>
  <span class="sr-only theme-toggle-state"></span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-od-id="theme-toggle"]');
  const state = button?.querySelector<HTMLElement>('.theme-toggle-state');

  /** 현재 테마를 버튼의 접근 가능한 이름과 상태 문구에 반영한다. */
  function render(theme: string) {
    if (state) state.textContent = `현재 테마: ${theme === 'dark' ? '다크' : '라이트'}`;
    button?.setAttribute('aria-label', theme === 'dark' ? '라이트 테마로 전환' : '다크 테마로 전환');
  }

  render(document.documentElement.dataset.theme ?? 'light');

  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // 저장이 막혀 있으면 이 세션 안에서만 전환을 유지한다.
    }
    render(next);
  });
</script>
