---
// 스크립트가 붙기 전에는 눌러도 반응하지 않으므로 감춰 두고, 스크립트가 드러낸다.
---

<form
  class="mb-9 flex w-full items-center gap-2.5 border-b border-border pb-3 text-muted focus-within:border-accent focus-within:text-accent"
  role="search"
  hidden
  data-od-id="post-search"
>
  <label class="sr-only" for="post-search-input">글 검색</label>
  <input
    class="w-full border-0 bg-transparent py-1 font-sans text-[0.95rem] text-fg outline-none placeholder:text-muted"
    id="post-search-input"
    type="search"
    placeholder="제목, 요약, 태그로 검색"
    autocomplete="off"
  />
  <button
    class="inline-flex min-h-11 min-w-11 items-center justify-center bg-transparent text-current hover:text-accent"
    type="submit"
    aria-label="검색 실행"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="h-[18px] w-[18px] shrink-0 fill-none stroke-current"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="10.5" cy="10.5" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
  </button>
</form>
