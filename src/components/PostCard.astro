---
import type { Post } from '../lib/posts';
import TagList from './TagList.astro';
import { toPostUrl } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li class="border-b border-border pb-8 last:border-b-0" data-od-id={`post-card-${post.id}`}>
  <h2 class="text-h3 leading-tight">
    <a
      href={toPostUrl(post)}
      class="text-fg no-underline hover:text-accent hover:underline underline-offset-4 visited:text-muted"
    >
      {post.data.title}
    </a>
  </h2>
  <p class="mt-3 font-sans text-caption leading-meta text-muted">{post.data.summary}</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
    <p class="font-mono text-caption leading-meta text-muted">
      <time datetime={post.data.date.toISOString()}>
        {dateFormat.format(post.data.date)}
      </time>
    </p>
    <TagList tags={post.data.tags} label={`${post.data.title}의 태그`} />
  </div>
</li>
