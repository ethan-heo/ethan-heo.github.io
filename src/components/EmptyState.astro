---
interface Props {
  title: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, actionHref, actionLabel } = Astro.props;
---

<div class="border border-border rounded-sm px-4 py-8 text-center" data-od-id="empty-state">
  <p class="font-sans text-caption leading-meta text-muted">{title}</p>
  {
    actionHref && actionLabel && (
      <p class="mt-3">
        <a
          href={actionHref}
          class="font-sans text-caption text-accent underline underline-offset-4 hover:text-link-hover"
        >
          {actionLabel}
        </a>
      </p>
    )
  }
</div>
